{
  "name": "C++ with uv (Automated)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  // Dynamic Environment Variables
  "remoteEnv": {
    // Automatically points to the .venv inside whatever your project folder is named
    "VIRTUAL_ENV": "${containerWorkspaceFolder}/.venv",
    // Prepend the venv bin to PATH so 'python' resolves to the venv version
    "PATH": "${containerWorkspaceFolder}/.venv/bin:${containerEnv:PATH}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "ms-python.python",
        "tamasfe.even-better-toml"
      ],
      "settings": {
        // Point VS Code to the dynamic venv path
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
        "cmake.generator": "Ninja"
      }
    }
  },
  // Initialize uv and install dependencies
  // --no-workspace allows uv to run even if pyproject.toml doesn't exist yet
  // --allow-existing prevents errors if re-building the container
  "postCreateCommand": "uv sync --dev",
  
  "remoteUser": "vscode"
}